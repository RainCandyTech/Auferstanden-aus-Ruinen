<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AaR.Server</RootNamespace>
    <AssemblyName>AaR.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- v0.5: OB11 长期数据存储 —— EF Core + SQLite 单引擎：
         Provider=sqlite → Data Source=<Path>（落盘）；Provider=memory → :memory:（共享缓存内存库），不引入 InMemory 包 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.1.0" />
  </ItemGroup>

</Project>
