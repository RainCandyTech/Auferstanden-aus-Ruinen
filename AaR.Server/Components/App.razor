<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>AaR WebUI</title>
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" rel="stylesheet" />
    <style>
        /* 面板补充样式（Fluent 体系之外的最小增补） */
        .topbar { display: flex; align-items: center; gap: 28px; padding: 14px 24px;
                  border-bottom: 1px solid var(--neutral-stroke-rest); position: sticky; top: 0;
                  background: var(--neutral-layer-floating); z-index: 10; flex-wrap: wrap; }
        .brand { font-size: 16px; font-weight: 600; letter-spacing: .5px; }
        .brand .ver { opacity: .5; font-weight: 400; font-size: 13px; margin-left: 6px; }
        .tabs { display: flex; gap: 4px; }
        .tabs a { color: var(--neutral-foreground-rest); text-decoration: none; padding: 6px 14px;
                  border-radius: 6px; font-size: 13px; opacity: .75; }
        .tabs a:hover { opacity: 1; background: var(--neutral-layer-hover); }
        .tabs a.on { opacity: 1; background: var(--neutral-layer-active); font-weight: 600; }
        .wrap { max-width: 1080px; margin: 0 auto; padding: 24px 20px 60px; }
        .stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin: 16px 0 22px; }
        .stat { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; }
        .stat .k { font-size: 11px; opacity: .7; text-transform: uppercase; letter-spacing: 1px; }
        .stat .v { font-size: 18px; font-weight: 600; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 8px 12px; text-align: left; font-size: 13px; border-bottom: 1px solid var(--neutral-stroke-rest); }
        th { opacity: .7; font-weight: 500; font-size: 11px; letter-spacing: 1px; }
        tr:last-child td { border-bottom: none; }
        .rc0 { color: var(--accent-fill-rest); }
        .rcX { color: var(--error); font-weight: 600; }
        .qr { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start; margin-top: 12px; }
        .qrbox { background: #fff; padding: 10px; border-radius: 8px; }
        .qrbox img { display: block; width: 200px; height: 200px; }
        .qrmeta { font-size: 12px; opacity: .8; max-width: 360px; word-break: break-all; }
        h1 { font-size: 18px; margin: 0; letter-spacing: .5px; }
        h2 { font-size: 13px; opacity: .7; letter-spacing: 1px; margin: 24px 0 10px; }
        .sub { font-size: 12px; opacity: .6; margin: 4px 0 0; }
        textarea { width: 100%; min-height: 140px; font-family: ui-monospace, monospace; font-size: 12px;
                   background: var(--neutral-layer-rest); color: var(--neutral-foreground-rest);
                   border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; padding: 10px; }
        pre { margin: 0; white-space: pre-wrap; word-break: break-all; font-size: 12px;
              font-family: ui-monospace, monospace; }
        .logline { font-family: ui-monospace, monospace; font-size: 12px; padding: 2px 10px; }
        .logline .lv-WARN { color: var(--warning); }
        .logline .lv-ERROR { color: var(--error); }
        .logline .cat { opacity: .55; }
        .logbox { max-height: 62vh; overflow: auto; border: 1px solid var(--neutral-stroke-rest);
                  border-radius: 8px; background: var(--neutral-layer-rest); padding: 8px 0; }
        .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .muted { opacity: .65; font-size: 12px; }
    </style>
</head>
<body data-theme="dark">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
