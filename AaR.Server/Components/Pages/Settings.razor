@page "/ui/settings"
@rendermode InteractiveServer
@using System.Web
@using AaR.Server.Ob11
@using AaR.Server.Services
@inject AaROptions Opts
@inject Ob11Audit Audit
@inject ReverseEndpointManager ReverseMgr
@inject NavigationManager Nav
@inject IThemeService Theme

@if (_authFailed)
{
    <FluentCard>
        <div style="padding:24px;text-align:center;">403 · 请携带 <code>?access_token=&lt;token&gt;</code></div>
    </FluentCard>
}
else
{
    <h1>设置与服务信息</h1>
    <p class="sub">运行时摘要（配置值脱敏）</p>

    <div class="stats" style="margin-top:16px;">
        <FluentCard Class="stat">
            <span class="k">版本</span>
            <span class="v">@Ob11Server.ServerVersion</span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">运行时长</span>
            <span class="v">@_uptime</span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">工作内存</span>
            <span class="v">@_mem MB</span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">OB11 累计调用</span>
            <span class="v">@Audit.Total</span>
        </FluentCard>
    </div>

    <h2>配置摘要</h2>
    <FluentCard Style="padding:4px;">
        <table>
            <tbody>
                <tr><td class="muted">鉴权</td><td>@(string.IsNullOrEmpty(Opts.AccessToken) ? "未设置（本机开放——公网部署前请配置 AccessToken）" : "已设置（" + Opts.AccessToken.Length + " 字符）")</td></tr>
                <tr><td class="muted">桥接端点</td><td>@Opts.BridgeHubPath</td></tr>
                <tr><td class="muted">正向 WS</td><td>@Opts.Ob11WsPath</td></tr>
                <tr><td class="muted">桥未连时 HTTP</td><td>@(Opts.RequireBridgeForHttp ? "返回 503" : "放行")</td></tr>
                <tr><td class="muted">内核 RPC 超时</td><td>@(Opts.BridgeTimeoutMs) ms</td></tr>
                <tr><td class="muted">心跳间隔</td><td>@(Opts.HeartbeatIntervalMs) ms</td></tr>
                <tr><td class="muted">存储</td><td>@Opts.Storage?.Provider → @Opts.Storage?.Path</td></tr>
                <tr><td class="muted">反向 WS 目标</td><td>@((Opts.Reverse?.WebSockets?.Count ?? 0)) 个@((Opts.Reverse?.WebSockets?.Any(t => !string.IsNullOrEmpty(t.SelfId)) == true ? "（含账号绑定）" : ""))</td></tr>
                <tr><td class="muted">反向 HTTP 目标</td><td>@((Opts.Reverse?.HttpPost?.Count ?? 0)) 个</td></tr>
                <tr><td class="muted">调试命令</td><td>@(Opts.EnableDebugCommand ? "#AaR 开启" : "关闭")</td></tr>
            </tbody>
        </table>
    </FluentCard>

    <h2>反向端点（存库 · 动态应用）</h2>
    <p class="sub">事件推送目标（反向 WS / HTTP POST）——增删启停即时生效；配置存 aar.db，appsettings 仅作首次 seed</p>
    <FluentCard Style="padding:4px;">
        @if (_targets.Count == 0)
        {
            <div class="muted" style="padding:16px;text-align:center;">尚无反向端点</div>
        }
        else
        {
            <table>
                <thead><tr><th>#</th><th>类型</th><th>URL</th><th>绑定账号</th><th>状态</th><th>操作</th></tr></thead>
                <tbody>
                    @foreach (var t in _targets)
                    {
                        <tr>
                            <td class="muted">@t.Id</td>
                            <td>@t.Kind</td>
                            <td style="word-break:break-all;max-width:360px;">@t.Url</td>
                            <td>@(string.IsNullOrEmpty(t.SelfId) ? "全量" : t.SelfId)</td>
                            <td><span style="color:@(t.Enabled ? "var(--accent-fill-rest)" : "var(--error)");">@(t.Enabled ? "启用" : "停用")</span></td>
                            <td>
                                <div class="row" style="gap:6px;">
                                    <FluentButton OnClick="@(() => _ = ToggleTargetAsync(t.Id, !t.Enabled))">@(_busyId == t.Id ? "…" : (t.Enabled ? "停用" : "启用"))</FluentButton>
                                    <FluentButton OnClick="@(() => _ = RemoveTargetAsync(t.Id))">删除</FluentButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </FluentCard>

    <div class="row" style="margin-top:10px;">
        <select @bind="_newKind" style="width:80px;">
            <option value="ws">ws</option>
            <option value="http">http</option>
        </select>
        <input type="text" @bind="_newUrl" placeholder="ws://host:port/onebot/v11/ws（或 http://host/onebot）" style="min-width:320px;" />
        <input type="text" @bind="_newToken" placeholder="访问令牌（可空）" style="min-width:140px;" />
        <input type="text" @bind="_newSelfId" placeholder="绑定 uin（可空=全量）" style="min-width:150px;" />
        <input type="number" @bind="_newReconnect" style="width:90px;" />
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@AddTargetAsync">添加</FluentButton>
        <span class="muted">@_newStatus</span>
    </div>
    <p class="sub" style="margin-top:6px;">管理面仅经 WebUI（页面 access_token gate）；端点集存 aar.db ReverseTargets 表，服务重启后自动恢复连接</p>

    <h2>主题</h2>
    <div class="row">
        <FluentButton OnClick="@(() => ToggleThemeAsync())">@(_dark ? "切换到亮色" : "切换到暗色")</FluentButton>
        <span class="muted">当前：@(_dark ? "暗色" : "亮色") · 经 IThemeService（引擎级，含浏览器记忆）</span>
    </div>
}

@code {
    private bool _authFailed;
    private bool _dark = true;
    private string _uptime = "-";
    private long _mem;
    private DateTime _procStart = DateTime.Now;
    private PeriodicTimer? _timer;

    // 反向端点管理（1.0.0-preview2）
    private IReadOnlyList<ReverseTargetView> _targets = Array.Empty<ReverseTargetView>();
    private string _newKind = "ws";
    private string _newUrl = "";
    private string _newToken = "";
    private string _newSelfId = "";
    private int _newReconnect = 5000;
    private string _newStatus = "";
    private long _busyId;

    protected override void OnInitialized()
    {
        var q = HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var token = q["access_token"] ?? "";
        if (!string.IsNullOrEmpty(Opts.AccessToken) && token != Opts.AccessToken)
        {
            _authFailed = true;
            return;
        }
        try { _procStart = System.Diagnostics.Process.GetCurrentProcess().StartTime; } catch { }
        Load();
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await _timer.WaitForNextTickAsync())
        {
            Load();
            StateHasChanged();
        }
    }

    private void Load()
    {
        var up = DateTime.Now - _procStart;
        _uptime = up.TotalHours >= 1 ? $"{(int)up.TotalHours} 时 {up.Minutes} 分" : $"{up.Minutes} 分 {up.Seconds} 秒";
        try { _mem = System.Diagnostics.Process.GetCurrentProcess().WorkingSet64 / 1024 / 1024; } catch { }
        _targets = ReverseMgr.Current;   // 快照直读（变更即刷，无库往返）
    }

    private async Task AddTargetAsync()
    {
        _newStatus = "添加中…";
        var added = await ReverseMgr.AddAsync(_newKind, _newUrl, _newToken, _newSelfId, _newReconnect);
        if (added is null)
        {
            _newStatus = "添加失败：类型须为 ws/http，URL 须为合法绝对地址";
            return;
        }
        _newStatus = $"已添加 #{added.Id}（即时生效）";
        _newUrl = ""; _newToken = ""; _newSelfId = "";
        Load();
    }

    private async Task ToggleTargetAsync(long id, bool enable)
    {
        _busyId = id;
        await ReverseMgr.SetEnabledAsync(id, enable);
        _busyId = 0;
        Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveTargetAsync(long id)
    {
        _busyId = id;
        await ReverseMgr.RemoveAsync(id);
        _busyId = 0;
        Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        // FluentUI v5 官方主题引擎（IThemeService）：token 重注 + data-theme 属性
        // + localStorage 记忆全套；裸 setAttribute 不触发引擎（旧实现无效的根因）
        await Theme.SwitchThemeAsync();
        _dark = await Theme.IsDarkModeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_authFailed)
        {
            try { _dark = await Theme.IsDarkModeAsync(); StateHasChanged(); } catch { }
        }
    }
}
