@page "/ui"
@rendermode InteractiveServer
@using System.Web
@inject BridgeRegistry Registry
@inject Ob11Audit Audit
@inject AaROptions Opts
@inject AaR.Server.Storage.Ob11Store Store
@inject NavigationManager Nav

@if (_authFailed)
{
    <FluentCard>
        <div style="padding:24px;text-align:center;">
            403 · access token 无效——请在 URL 上携带 <code>?access_token=&lt;token&gt;</code>
        </div>
    </FluentCard>
}
else
{
    <h1>总览</h1>
    <p class="sub">桥接与服务状态 · 每 2 秒刷新</p>

    <div class="stats">
        <FluentCard Class="stat">
            <span class="k">桥接状态</span>
            <span class="v" style="color:@(Registry.IsBridgeConnected ? "var(--accent-fill-rest)" : "var(--error)")">
                @(Registry.IsBridgeConnected ? "已连接" : "未连接")
            </span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">在线槽位 / 已绑</span>
            <span class="v">@_overview.Count / @_boundCount</span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">OB11 调用 / 失败</span>
            <span class="v">@Audit.Total <span style="opacity:.6;font-size:13px">/ <span class="rcX">@Audit.Fail</span></span></span>
        </FluentCard>
        <FluentCard Class="stat">
            <span class="k">运行时长</span>
            <span class="v">@_uptime</span>
        </FluentCard>
    </div>

    <h2>最近调用</h2>
    <FluentCard Style="padding:4px;">
        @if (_recent.Count == 0)
        {
            <div class="muted" style="padding:14px;text-align:center;">尚无 OB11 调用记录</div>
        }
        else
        {
            <table>
                <thead><tr><th>时间</th><th>动作</th><th>槽</th><th>retcode</th><th>耗时</th></tr></thead>
                <tbody>
                    @foreach (var c in _recent)
                    {
                        <tr>
                            <td class="muted">@c.At.ToString("HH:mm:ss")</td>
                            <td>@c.Action</td>
                            <td class="muted">@(c.Target ?? "-")</td>
                            <td class="@(c.Retcode == 0 ? "rc0" : "rcX")">@c.Retcode</td>
                            <td class="muted">@c.Ms ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </FluentCard>

    <h2>槽位</h2>
    @if (_overview.Count == 0)
    {
        <FluentCard><div class="muted" style="padding:16px;text-align:center;">无在线槽位</div></FluentCard>
    }
    else
    {
        <FluentCard Style="padding:4px;">
            <table>
                <thead><tr><th>状态</th><th>桥型</th><th>版本</th><th>槽</th><th>账号</th></tr></thead>
                <tbody>
                    @foreach (var s in _overview)
                    {
                        var state = s["state"] as string ?? "";
                        <tr>
                            <td><span style="color:@(state == "bound" ? "var(--accent-fill-rest)" : state == "pending" ? "var(--warning)" : "var(--neutral-foreground-rest)");">@state</span></td>
                            <td>@s["bridge"]</td>
                            <td>@(string.IsNullOrEmpty(s["version"] as string) ? "-" : s["version"])</td>
                            <td>@(string.IsNullOrEmpty(s["slot"] as string) ? "-" : s["slot"])</td>
                            <td>@(s["uin"] is string uin && uin.Length > 0 ? uin : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </FluentCard>
    }

    @if (_pendingQr.Count > 0)
    {
        <h2>待扫码登录</h2>
        <FluentCard>
            <div style="padding:16px;">
                <div class="qr">
                    @foreach (var p in _pendingQr)
                    {
                        <div class="qrbox">
                            @if (p["qr_png"] is string png && png.Length > 0)
                            {
                                <img src="data:image/png;base64,@png" alt="登录二维码" />
                            }
                            else
                            {
                                <div style="width:200px;height:200px;display:flex;align-items:center;justify-content:center;color:#333;">无码图</div>
                            }
                        </div>
                        <div class="qrmeta">
                            <div>更新于 @p["qr_at"]</div>
                            <div style="margin-top:8px;"><a href="@(p["qr_url"] as string)" target="_blank" rel="noopener">浏览器打开二维码</a></div>
                            <div style="margin-top:8px;word-break:break-all;">@(p["qr_url"])</div>
                        </div>
                    }
                </div>
            </div>
        </FluentCard>
    }

    <h2>已知账号（存库）</h2>
    @if (_accounts.Count == 0)
    {
        <FluentCard><div class="muted" style="padding:16px;text-align:center;">尚无账号档案——桥 hello 绑定后自动建档（跨重启存活）</div></FluentCard>
    }
    else
    {
        <FluentCard Style="padding:4px;">
            <table>
                <thead><tr><th>状态</th><th>账号</th><th>昵称</th><th>桥型</th><th>版本</th><th>最近绑定</th><th>最近离线</th></tr></thead>
                <tbody>
                    @foreach (var a in _accounts)
                    {
                        var online = _boundUins.Contains(a.Uin);
                        <tr>
                            <td><span style="color:@(online ? "var(--accent-fill-rest)" : "var(--neutral-foreground-rest)");opacity:@(online ? "1" : ".55");">@(online ? "在线" : "离线")</span></td>
                            <td>@a.Uin</td>
                            <td>@(string.IsNullOrEmpty(a.Nickname) ? "-" : a.Nickname)</td>
                            <td>@a.Bridge</td>
                            <td class="muted">@a.Version</td>
                            <td class="muted">@a.LastSeenAt.ToString("MM-dd HH:mm")</td>
                            <td class="muted">@(a.LastOfflineAt?.ToString("MM-dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </FluentCard>
        <p class="muted" style="margin:8px 0 0;">正向 WS 账号路径：ws://&lt;host&gt;:5600/ws/&lt;uin&gt;（如 /ws/@(_accounts.Count > 0 ? _accounts[0].Uin : "3774879303")）——仅收该账号事件，调用默认路由到该账号槽</p>
    }
}

@code {
    private bool _authFailed;
    private List<Dictionary<string, object?>> _overview = new();
    private List<Ob11Audit.Call> _recent = new();
    private int _boundCount;
    private List<Dictionary<string, object?>> _pendingQr = new();
    private List<AaR.Server.Storage.AccountRecord> _accounts = new();
    private HashSet<string> _boundUins = new(StringComparer.Ordinal);
    private string _uptime = "-";
    private DateTime _procStart = DateTime.Now;
    private PeriodicTimer? _timer;

    protected override void OnInitialized()
    {
        var q = HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var token = q["access_token"] ?? "";
        if (!string.IsNullOrEmpty(Opts.AccessToken) && token != Opts.AccessToken)
        {
            _authFailed = true;
            return;
        }
        try { _procStart = System.Diagnostics.Process.GetCurrentProcess().StartTime; } catch { }
        Load();
        _ = LoadAccountsOnceAsync();
        _ = RefreshLoopAsync();
    }

    private async Task LoadAccountsOnceAsync()
    {
        _accounts = await Store.ListAccountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLoopAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        while (await _timer.WaitForNextTickAsync())
        {
            Load();
            await LoadAccountsAsync();
            StateHasChanged();
        }
    }

    private void Load()
    {
        _overview = Registry.DescribeOverview();
        _recent = Audit.Recent(40).OrderByDescending(c => c.At).ToList();
        _boundCount = _overview.Count(s => s["state"] as string == "bound");
        _pendingQr = _overview.Where(s => s["state"] as string == "pending" && !string.IsNullOrEmpty(s["qr_url"] as string)).ToList();
        _boundUins = _overview
            .Where(s => s["state"] as string == "bound" && s["uin"] is string u && u.Length > 0)
            .Select(s => (string)s["uin"]!)
            .ToHashSet(StringComparer.Ordinal);
        var up = DateTime.Now - _procStart;
        _uptime = up.TotalHours >= 1 ? $"{(int)up.TotalHours} 时 {up.Minutes} 分" : $"{up.Minutes} 分 {up.Seconds} 秒";
    }

    /// <summary>账号档案是 SQLite 读，走独立 async 拍（每 5s 一次，与 2s 槽位拍错开）。</summary>
    private int _accountsTick;

    private async Task LoadAccountsAsync()
    {
        if (++_accountsTick % 3 != 1) return; // 2s × 3 ≈ 6s 一拍
        _accounts = await Store.ListAccountsAsync();
    }
}
